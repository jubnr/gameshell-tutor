# Working copy of the bundled game: install.sh patches archives in place and
# the engine rewrites them on autosave, so play.sh plays from a copy here.
/.game/

__pycache__/
*.pyc
*.bak

# NOTE: demo/index.html IS tracked on purpose. It is generated by
# demo/build.py, but Netlify serves demo/ straight from git, so the built
# page has to be in the repo. Rebuild it after changing hints or goal texts.
